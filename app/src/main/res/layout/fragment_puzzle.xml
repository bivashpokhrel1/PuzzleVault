<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← Back"
            android:textColor="@color/textSecondary"
            android:layout_gravity="start" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puzzles"
            android:textSize="28sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center" />

        <!-- Wire Circuit -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wire Circuit"
                    android:textSize="18sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect matching nodes to complete the circuit"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="12dp" />

                <com.jeiu.puzzlevault.ui.puzzle.WireCircuitView
                    android:id="@+id/wireCircuitView"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnWireReset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Reset"
                    android:textColor="@color/textSecondary"
                    android:layout_gravity="end" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Keypad -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keypad"
                    android:textSize="18sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter the correct code sequence"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="12dp" />

                <com.jeiu.puzzlevault.ui.puzzle.KeypadPuzzleView
                    android:id="@+id/keypadPuzzleView"
                    android:layout_width="match_parent"
                    android:layout_height="380dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnKeypadReset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Reset"
                    android:textColor="@color/textSecondary"
                    android:layout_gravity="end" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Grid Slide -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grid Slide"
                    android:textSize="18sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slide tiles into numerical order"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="12dp" />

                <com.jeiu.puzzlevault.ui.puzzle.GridSlideView
                    android:id="@+id/gridSlideView"
                    android:layout_width="match_parent"
                    android:layout_height="380dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnGridReset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Reset"
                    android:textColor="@color/textSecondary"
                    android:layout_gravity="end" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    <!-- Rotatable Wire Circuit (3x3) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rotatable Circuit (3×3)"
                    android:textSize="18sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap tiles to rotate. Connect start → end."
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="12dp" />

                <com.jeiu.puzzlevault.ui.puzzle.RotatableWireCircuitView
                    android:id="@+id/rotatableWireView"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnRotatableReset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="New Puzzle"
                    android:textColor="@color/textSecondary"
                    android:layout_gravity="end" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
